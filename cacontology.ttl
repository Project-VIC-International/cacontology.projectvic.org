    rdfs:subClassOf cac-core:Artifact,
        uco-core:UcoObject .

cacontology-multi:InformationSharing a owl:Class ;
    rdfs:label "Information Sharing"@en ;
    rdfs:comment "Formal sharing of intelligence or evidence between jurisdictions."@en ;
